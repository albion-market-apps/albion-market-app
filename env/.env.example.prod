# Template de produção (free tiers) — Render (API/worker) + Vercel (web) +
# Neon (Postgres) + Upstash (Redis). NÃO commitar o `.env` real preenchido —
# estes valores vão direto no painel de "Environment Variables" de cada
# serviço (Render/Vercel), nunca em um arquivo no repositório.
#
# Passo a passo completo: docs/DEPLOY_FREE_TIERS.md

# Neon → Dashboard → Connection string → modo "Pooled connection" →
# troque o prefixo `postgresql://` por `postgresql+psycopg://` e garanta
# `?sslmode=require` no final (Neon exige SSL).
DATABASE_URL=postgresql+psycopg://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require

# Upstash → Database → "Redis Connect" → usar a URL `rediss://` (TLS) do
# botão "Node.js"/"ioredis" — redis-py aceita o mesmo formato.
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:<port>

# Mesmo UUID usado no seed de produção — gerar uma vez e nunca trocar depois
# (ver bug documentado em docs/claude.md: trocar TENANT_DEFAULT_ID depois do
# primeiro seed quebra a unique constraint do slug "default").
TENANT_DEFAULT_ID=<uuid-v4-gerado-uma-vez-e-fixo>

API_RATE_LIMIT=60

# Sentry (opcional) — DSN do projeto, se for usar.
SENTRY_DSN=

ALBION_BASE_URL=https://www.albion-online-data.com/api/v2/stats

# --- Só para o serviço web (Vercel/Netlify) — não vai no .env da API ---
# URL pública da API no Render, ex.: https://albion-api.onrender.com
# Nome exato importa: web/next.config.js lê API_BASE_URL (sem prefixo
# NEXT_PUBLIC_) porque o rewrite roda no servidor, não no browser — usar o
# nome errado faz a busca falhar silenciosamente com 500 (bug real batido
# no deploy do turno 9, ver docs/claude.md).
API_BASE_URL=https://<seu-servico>.onrender.com
