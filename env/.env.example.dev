# Template de desenvolvimento local (Docker Compose). Copie para a raiz do
# projeto como `.env`: `cp env/.env.example.dev .env`.
#
# Hostnames aqui são para quem roda backend/worker FORA dos containers
# (ex.: `poetry run uvicorn` direto no host, com `docker compose up db redis`
# publicando as portas em localhost). Dentro dos containers `api`/`worker`,
# o `infra/docker-compose.yml` já define DATABASE_URL/REDIS_URL apontando
# para os hostnames da rede do Compose (`db`, `redis`) — essas duas linhas
# abaixo são ignoradas nesse caso.

DATABASE_URL=postgresql+psycopg://albion:albion@localhost:5432/albion
REDIS_URL=redis://localhost:6379/0

# Gere um UUID v4 novo (não reuse o de produção): `python3 -c "import uuid; print(uuid.uuid4())"`
TENANT_DEFAULT_ID=00000000-0000-0000-0000-000000000001

# Inteiro simples (req/min) — NÃO use o formato "60/m".
API_RATE_LIMIT=120

SENTRY_DSN=

# Base da Albion Online Data Project — o worker já monta
# "{ALBION_BASE_URL}/prices/{items}.json"; não inclua "/prices" aqui.
ALBION_BASE_URL=https://www.albion-online-data.com/api/v2/stats
