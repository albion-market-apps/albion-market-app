# Postgres (usado por backend e worker). Hostnames aqui são para quem roda o
# backend/worker FORA do Docker (ex.: `poetry run uvicorn` direto no host,
# com `docker compose up db redis` publicando as portas em localhost).
# Dentro dos containers `api`/`worker`, o `infra/docker-compose.yml` já seta
# DATABASE_URL/REDIS_URL explicitamente apontando para os hostnames da rede
# do Compose (`db`, `redis`) — essas duas linhas abaixo são ignoradas nesse
# caso (environment: do serviço tem precedência sobre o env_file).
DATABASE_URL=postgresql+psycopg://albion:albion@localhost:5432/albion

# Redis (compatível com Upstash em produção)
REDIS_URL=redis://localhost:6379/0

# Multi-tenant: tenant usado quando o header X-Tenant-ID não é enviado
TENANT_DEFAULT_ID=00000000-0000-0000-0000-000000000001

# Rate limit da API, em requisições/minuto por tenant. É um inteiro simples
# (não o formato "60/m" de libs tipo slowapi) — `app/core/config.py` tipa
# como `int`; mudar o formato exige atualizar o parsing lá também.
API_RATE_LIMIT=120

# Observabilidade (vazio = desabilitado)
SENTRY_DSN=

# Fonte de dados de preços do Albion Online (Albion Online Data Project)
ALBION_BASE_URL=https://www.albion-online-data.com/api/v2/stats
